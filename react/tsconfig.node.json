{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "types": [
      "babel__core",
      "babel__generator",
      "babel__template",
      "babel__traverse",
      "estree",
      "json-schema",
      "node"
    ]
  },
  "include": ["./vite.config.ts"],
  "exclude": ["node_modules"]
}
